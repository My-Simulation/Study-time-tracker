rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Screenshots path ───────────────────────────────────────────────────
    // Allow read/write under screenshots/{userName}/...
    //
    // KNOWN LIMITATION: Since this app uses name-based auth (no Firebase Auth),
    // it is not possible to cryptographically verify the requesting user's identity
    // from Storage rules alone. The rules below allow anyone who knows the path
    // to read/write, which is acceptable for a personal/demo app.
    //
    // For production: integrate Firebase Authentication, then replace
    //   allow write: if true;
    // with:
    //   allow write: if request.auth != null && request.auth.token.name == userName;
    //
    match /screenshots/{userName}/{filename} {
      allow read: if true;
      allow write: if true;
    }

    // ── Deny everything else ───────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
